    [
      "debug_mode",
      true,
      "When true: write raw REST API request/response pairs to logs/raw_api_debug_*.json and logs/raw_api_error_*.json (rotated, last 5 kept). Defaults True: this being off is why the HTTP 400 issue went undiagnosed through two prior fix attempts."
    ],
    [
      "health_check_on_startup",
      true,
      "When true: fire one minimal REST API call at startup so a bad key/model surfaces immediately instead of mid-conversation"
    ],
    [
      "network_error_auto_retry",
      true,
      "When true: a NETWORK ERROR (dropped connection, no route) auto-resends the same turn instead of waiting for the user to manually retype it"
    ],
    [
      "network_error_retry_backoff_seconds",
      3.0,
      "Delay before an auto-resend triggered by network_error_auto_retry"
    ],
    [
      "auto_amnesia_memory_retrieval",
      true,
      "When true, /amnesia (agent.py) or the webagent Amnesia button immediately re-feeds the compressed recap back into history ('rebirth') as soon as it wipes memory. When false, /amnesia wipes to a true blank slate and the recap waits on disk until /rebirth is run manually."
    ]
  ]
}