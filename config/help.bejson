      "models.topic.01",
      "models",
      "topic",
      "",
      "Models & Engines",
      "",
      "The active model decides the provider. /model switches model (Gemini or OpenRouter); /engine picks the transport.",
      20
    ],
    [
      "models.command.01",
      "models",
      "command",
      "/model",
      "Show model catalog, switch model, or /model sync for free models",
      "/model [num|id|sync]",
      "Show the model catalog, switch active model, or sync free models.\n  /model               - List all available models (Gemini & OpenRouter)\n  /model sync          - Pull live 100% free models from OpenRouter into catalog\n  /model <num>         - Switch model by catalog number (e.g. /model 10)\n  /model <provider/id> - Switch to any OpenRouter model (e.g. meta-llama/llama-3.3-70b-instruct)\n  * Non-Gemini models automatically route through REST engine and use the OpenRouter key pool.",
      10
    ],
    [
      "models.command.02",
      "models",
      "command",
      "/engine",
      "Toggle between REST and Interactions engines",
      "/engine",
      "Toggle between the REST engine (standard API calls, used for Gemini & OpenRouter) and the Interactions engine (Gemini stateful interactions loop).\n  * Note: OpenRouter models require the REST engine and will auto-switch to REST if selected.",
      20
    ],
    [
      "models.command.03",
      "models",
      "command",
      "/toolscope",
      "Cycle interactions tool scope (all | shell_only)",
      "/toolscope",
      "",
      30
    ],
    [
      "models.command.04",
      "models",
      "command",
      "/resumemode",
      "Toggle Interactions resume strategy",
      "/resumemode",
      "",
      40
    ],
    [
      "models.note.01",
      "models",
      "note",
      "",
      "",
      "",
      "Provider follows the model: an OpenRouter model (provider/id) is routed through the REST engine and the OpenRouter key pool; Gemini models use the Gemini pool.",
      10
    ],
    [
      "models.note.02",
      "models",
      "note",
      "",
      "",
      "",
      "The Interactions engine is Gemini-only. /engine refuses to switch to it while an OpenRouter model is active, and picking an OpenRouter model while on Interactions auto-switches back to REST.",
      20
    ],
    [
      "models.note.03",
      "models",
      "note",
      "",
      "",
      "",
      "/model sync adds the live 100% free OpenRouter models to the catalog and numbers them so /model <num> can select them.",
      30
